# Réglages de PAGINITY (copié en /etc/paginity/paginity.env, droits 640 root:paginity).
# Aucun mot de passe ni clé ici : ils se saisissent dans l'interface et sont chiffrés dans le coffre.
PAGINITY_DATA_DIR=/var/lib/paginity
# 127.0.0.1 : seul le relais local (Cloudflare Tunnel, Caddy…) joint PAGINITY. Mettre 0.0.0.0 pour le réseau de la maison.
PAGINITY_HOST=127.0.0.1
PAGINITY_ADMIN_PORT=8080
PAGINITY_PREVIEW_PORT=8081
PAGINITY_SITES_PORT=8082
# Adresse de l'administration telle que vous la tapez dans le navigateur (sert aussi aux passkeys).
PAGINITY_PUBLIC_URL=http://localhost:8080
# Derrière un relais installé sur cette machine uniquement (voir GUIDE-PROTOTYPE.md).
PAGINITY_TRUST_PROXY=false
# Podman obligatoire en production (isolation forte des fonctions des sites).
PAGINITY_ISOLATION=podman

# Fuseau horaire de l'heure de sauvegarde et des journées de visites (par défaut : Europe/Paris).
# PAGINITY_FUSEAU=Europe/Paris
